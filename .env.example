# Copy this file to ".env" and fill in your own values.
# ".env" is listed in .gitignore so it is never committed.
# Never paste real keys into this example file.

# Optional. Adzuna gives only 25 trial calls; real use is a paid plan
# (https://developer.adzuna.com). Leave these as-is to skip Adzuna.
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# Optional. Free key from https://www.themuse.com/developers/api/v2
# (works without a key too, at a lower rate limit)
MUSE_API_KEY=your_muse_api_key_here
